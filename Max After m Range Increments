class Solution {
    public int findMax(int n, int[] a, int[] b, int[] k) {
        // code here
        int[] arr = new int[n];
        int i,j;
        for(i=0;i<n;i++)
            arr[i]=0;
        
        for(i=0;i<a.length;i++){
            for(j=a[i];j<=b[i];j++){
                arr[j] += k[i];
            }
        }
        int max = arr[0];
        for(i=1;i<n;i++){
            if(arr[i]>max)
                max=arr[i];
        }
    return max;
    }
    
}
